# ╔══════════════════════════════════════════════════════╗
# ║           MusicVault — Environment Config           ║
# ╚══════════════════════════════════════════════════════╝

# ── REQUIRED ─────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram Channel ID — the database channel
# The bot MUST be an admin in this channel
# Format: -100xxxxxxxxxx  (supergroup/channel ID, always negative)
# How to get it: forward a message from the channel to @userinfobot
DB_CHANNEL=-100xxxxxxxxxx


# ── RECOMMENDED ──────────────────────────────────────────

# Your Telegram user ID(s) — comma separated, no spaces
# Admins can: upload, delete, restart, resync
# Leave empty to allow ALL users to do everything (not recommended)
# How to get your ID: message @userinfobot
ADMIN_IDS=123456789

# Public HTTPS URL where the web player is accessible
# Required for the "Open Player" Mini App button inside Telegram
# For local dev: run  ngrok http 8080  and paste the https URL here
# For production: your domain e.g. https://music.yourdomain.com
PUBLIC_URL=https://your-ngrok-or-domain-url-here


# ── OPTIONAL ─────────────────────────────────────────────

# Port for the local HTTP server (default: 8080)
HTTP_PORT=8080
